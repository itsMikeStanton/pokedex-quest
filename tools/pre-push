#!/bin/sh
# Refuse to push changed code without bumping the ?v= cache-bust in index.html.
# Without the bump, returning players keep their cached game.js/style.css and see
# nothing at all — a silently dead release (this has happened before, in 626d505).
#
# Install:  ln -sf ../../tools/pre-push .git/hooks/pre-push
# Bypass:   git push --no-verify
CODE="game.js style.css world.js data.js net.js"
ZERO=0000000000000000000000000000000000000000
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                      # branch deletion
  case "$remote_ref" in *gh-pages) ;; *) continue ;; esac     # only the live branch

  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git rev-parse "$local_sha^" 2>/dev/null) || continue
  else
    base=$remote_sha
  fi

  changed=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || continue
  hit=0
  for f in $CODE; do
    printf '%s\n' "$changed" | grep -Fxq "$f" && hit=1
  done
  [ "$hit" -eq 0 ] && continue

  old=$(git show "$base:index.html"      2>/dev/null | grep -oE 'game\.js\?v=[0-9.]+' | head -1)
  new=$(git show "$local_sha:index.html" 2>/dev/null | grep -oE 'game\.js\?v=[0-9.]+' | head -1)

  if [ "$old" = "$new" ]; then
    echo "" >&2
    echo "  ✗ pre-push blocked: code changed but the cache-bust is still ${new:-<none>}" >&2
    echo "" >&2
    printf '%s\n' "$changed" | grep -Fx -e game.js -e style.css -e world.js -e data.js -e net.js | sed 's/^/      changed: /' >&2
    echo "" >&2
    echo "  Returning players would keep their cached copies and see none of it." >&2
    echo "  Bump the ?v= on all 5 asset refs in index.html, then re-push." >&2
    echo "  (Intentional? git push --no-verify)" >&2
    echo "" >&2
    fail=1
  fi
done

exit $fail
